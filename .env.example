WILLHABEN_CYCLE_INTERVAL_SECONDS=60
WILLHABEN_MAX_CONCURRENT_REQUESTS=2
WILLHABEN_DATABASE_PATH=data/willhaben_suchagent.db
WILLHABEN_API_HOST=127.0.0.1
WILLHABEN_API_PORT=8000
WILLHABEN_APP_ENVIRONMENT=development
WILLHABEN_SCHEDULER_ENABLED=true
WILLHABEN_DESKTOP_SOUND_ENABLED=true
WILLHABEN_DESKTOP_SOUND_ID=notify
WILLHABEN_MARKETPLACE_USER_AGENT="Willhaben-Suchagent/0.3 (public Marketplace search; no authentication)"
WILLHABEN_MARKETPLACE_CONNECT_TIMEOUT_SECONDS=10
WILLHABEN_MARKETPLACE_READ_TIMEOUT_SECONDS=20
WILLHABEN_MARKETPLACE_MAX_REDIRECTS=3
WILLHABEN_MARKETPLACE_MAX_RESPONSE_BYTES=5000000

# ntfy is optional. Choose a private, hard-to-guess topic before enabling it.
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_TIMEOUT=10

# Discord is optional. Create an incoming webhook on the target channel first.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_TIMEOUT_SECONDS=10

# E-Mail is optional. Uses SMTP with STARTTLS by default.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_TO_ADDRESS=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=10

# Each search agent can independently enable/disable each channel; every channel
# defaults to on and delivery still requires the channel above to be enabled.
# See notify_ntfy / notify_discord / notify_email / notify_desktop_sound per search.
