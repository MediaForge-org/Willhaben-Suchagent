{
  "manifest_version": 3,
  "name": "Willhaben-Suchagent",
  "version": "0.4.0",
  "description": "Bedienoberfläche für den lokalen Willhaben-Suchagenten.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Willhaben-Suchagent",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["clipboardWrite", "nativeMessaging"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "willhaben-suchagent@local",
      "strict_min_version": "115.0"
    }
  }
}
